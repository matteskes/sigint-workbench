# SIGINT Workbench Environment
# Copy to .env and fill in values

# --- Database ---
POSTGRES_USER=sdr
POSTGRES_PASSWORD=sdr
POSTGRES_DB=sdr
# Leave DB_URL unset (§16.6): compose defaults it to the in-network
# `db` host, native processes default to localhost. A host-side value
# here would leak into the containers and break their DB connection.
# Override only when the database lives elsewhere:
# DB_URL=postgres://sdr:sdr@db:5432/sdr?sslmode=disable
# Native-process override consumed by scripts/dev-macos.sh (host-side):
# DB_URL_LOCAL=postgres://sdr:sdr@localhost:5432/sdr?sslmode=disable

# --- Services ---
# Only variables actually consumed by code or compose (A4: the retired
# CLASSIFIER_PORT/LOCATION_SERVICE_PORT stubs and the never-consumed
# SDR_CAPTURE_UDP_PORT_*/SIGNAL_PROCESSOR_PORT/WS_HUB_PORT are gone —
# per-device stream targets live in sdr-capture.yaml stream_host/port).
IQ_INGEST_UDP_PORT=9000
API_GATEWAY_PORT=8080

# recorder: UDP IQ in (9011), internal /ws/audio WS (9012, §10.4) and
# internal TFR API (9013, §19.3)
RECORDER_UDP_PORT=9011
# RECORDER_WS_PORT=9012
# RECORDER_TFR_PORT=9013

# signal-processor → capture control-API host (§5.6 gain polling).
# Compose default is the sdr-capture service; macOS dev (native
# capture) points it at the host:
# CAPTURE_API_HOST=host.docker.internal

# --- CORS / WebSocket origins ---
# Comma-separated allowlist used by api-gateway (CORS) and ws-hub
# (WS CheckOrigin). Leave commented for the default frontend origins;
# set to an empty value to deny all cross-origin requests.
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- WebSocket hub client cap (§14.3) ---
# Max concurrent /ws clients ws-hub admits; upgrades beyond the cap
# are refused with 503 (surfaced as 502 by the gateway's /ws relay).
# Default 1024; 0 disables the cap. Negative/invalid values fall
# back to the default (fail-safe).
# WS_HUB_MAX_CLIENTS=1024


# --- api-gateway upstreams ---
# Defaults inside compose: recorder:9012 (/ws/audio relay, §10.4)
# and sdr-capture:9090 (control-API proxy, §7.4). make dev exports
# CAPTURE_CTRL_ADDR=host.docker.internal:9090 automatically (native
# capture); override only if capture listens elsewhere:
# CAPTURE_CTRL_ADDR=host.docker.internal:9090
# RECORDER_WS_ADDR=host.docker.internal:9012

# --- api-gateway setup screen (SPEC §20) ---
# Writable directory holding the five editable service YAMLs
# (sdr-capture, signal-processor, recorder, classifier,
# iq-ingest; §16.5/§20.3). Compose mounts ./config at /config
# with CONFIG_DIR=/config; native runs default to ./config —
# override only if the YAMLs live elsewhere:
# CONFIG_DIR=/etc/sigint-workbench

# --- Frontend ---
VITE_API_URL=http://localhost:8080
# The gateway /ws relay (§2.2, A3) — never the hub directly.
VITE_WS_URL=ws://localhost:8080/ws
# tileserver-gl auto-serves the first tiles/data/*.mbtiles (alphabetical)
# as source "v3" — same id the frontend code defaults to.
VITE_TILE_URL=http://localhost:8082/data/v3/{z}/{x}/{y}.pbf

# --- Tiles ---
TILE_SERVER_PORT=8082

# --- Logging ---
LOG_LEVEL=info