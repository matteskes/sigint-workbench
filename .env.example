# SIGINT Workbench Environment
# Copy to .env and fill in values

# --- Database ---
POSTGRES_USER=sdr
POSTGRES_PASSWORD=sdr
POSTGRES_DB=sdr
DB_URL=postgres://sdr:sdr@localhost:5432/sdr?sslmode=disable

# --- SDR Capture ---
# UDP ports for IQ streaming (one per SDR)
SDR_CAPTURE_UDP_PORT_0=9000
SDR_CAPTURE_UDP_PORT_1=9001

# --- Services ---
IQ_INGEST_UDP_PORT=9000
SIGNAL_PROCESSOR_PORT=9010
CLASSIFIER_PORT=9011
RECORDER_PORT=9012
LOCATION_SERVICE_PORT=9013
API_GATEWAY_PORT=8080
WS_HUB_PORT=8081

# --- Frontend ---
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8081
VITE_TILE_URL=http://localhost:8082/data/{z}/{x}/{y}.pbf

# --- Tiles ---
TILE_SERVER_PORT=8082

# --- Logging ---
LOG_LEVEL=info