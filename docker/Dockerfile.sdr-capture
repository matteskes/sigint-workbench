# Multi-stage build for sdr-capture (requires cgo + librtlsdr + libhackrf)
# Only used in Linux prod mode (USB passthrough into container).
# Both hardware drivers are compiled in (build tags rtlsdr,hackrf, §15);
# with no hardware attached the simulator driver is unaffected.

FROM golang:1.25-bookworm AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    pkg-config \
    librtlsdr-dev \
    libhackrf-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 GOOS=linux go build -tags "rtlsdr,hackrf" -ldflags="-s -w" -o /app/sdr-capture ./cmd/sdr-capture

FROM debian:bookworm-slim
# Security-upgrade the base perl-base: the debian:bookworm-slim
# snapshot can lag the current security point release, which the
# trivy CRITICAL gate flags (same rationale as the fresh nginx
# install in Dockerfile.frontend).
RUN apt-get update && apt-get install -y --no-install-recommends \
    librtlsdr0 \
    libhackrf0 \
    ca-certificates \
    && apt-get install -y --only-upgrade perl-base \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/sdr-capture /sdr-capture
ENTRYPOINT ["/sdr-capture"]