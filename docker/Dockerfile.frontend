# Multi-stage build for SvelteKit frontend

FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Vite env is baked into the bundle at build time (there is no runtime
# substitution) — pass browser-reachable URLs via --build-arg (the
# compose file wires these to host-published ports by default).
ARG VITE_API_URL=http://localhost:8080
ARG VITE_WS_URL=ws://localhost:8080/ws
ARG VITE_TILE_URL=http://localhost:8082/data/{z}/{x}/{y}.pbf
ENV VITE_API_URL=$VITE_API_URL \
    VITE_WS_URL=$VITE_WS_URL \
    VITE_TILE_URL=$VITE_TILE_URL
RUN npm run build

# Fresh nginx install from the current alpine repos. The official
# nginx:X-alpine image bakes in an nginx build that current apk-tools
# refuses to replace (apk upgrade silently skips it), leaving CVEs in the
# nginx package itself unpatched. A fresh install upgrades cleanly.
FROM alpine:3.23
RUN apk update \
    && apk add --no-cache nginx \
    && apk upgrade --no-cache
COPY --from=builder /app/build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/http.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]