{
  "globs": ["**/*.md"],
  "ignores": ["**/node_modules/**", "frontend/node_modules/**", "**/.venv/**", "**/.ort/**"],
  "config": {
    "default": true,
    // Keep prose at 250 cols (technical specs need wider lines);
    // tables/code blocks remain checked (existing behavior).
    "MD013": { "line_length": 250, "code_blocks": false, "tables": false },
    // Non-actionable rules in spec/markdown docs — these relate to
    // table cell content, emphasis-as-heading, and code block language
    // which are stylistic decisions not relevant to spec correctness.
    "MD033": false,
    "MD036": false,
    "MD040": false,
    "MD056": false,
    "MD060": false
  }
}